<section class="min-h-screen flex flex-col justify-center items-start py-20 relative overflow-hidden bg-white">
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-blue-50 rounded-full blur-3xl -z-10 opacity-50"></div>

    <div class="container mx-auto px-6 max-w-7xl"> <div class="space-y-12">
            
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-100 text-blue-700 text-xs font-bold uppercase tracking-widest">
                <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-600"></span>
                </span>
                Disponible para nuevos proyectos
            </div>

            <div class="flex flex-col md:flex-row md:items-center justify-between gap-16 md:gap-32">
                
                <div class="flex-1 space-y-10">
                    <h1 class="text-7xl md:text-9xl font-black tracking-tighter leading-[0.85] text-black">
                        AARON <br />
                        <span class="text-blue-600">ISRAEL</span>
                    </h1>

                    <h2 class="text-2xl md:text-4xl font-light text-gray-500 max-w-xl leading-tight">
                        <strong class="font-bold text-black text-3xl">Backend Developer <span class="font-black bg-slate-950 text-white px-3 py-1 inline-block transform -skew-x-6 text-2xl md:text-3xl">Fullstack</span></strong> 
                        Especializado en transformar lógica compleja en experiencias digitales fluidas.
                    </h2>
                </div>

                <div class="relative group flex-shrink-0">
                    <div class="absolute inset-0 bg-blue-500 rounded-full blur-[80px] opacity-10 group-hover:opacity-25 transition-opacity duration-700"></div>
                    
                    <div class="relative animate-bounce duration-[3000ms] w-48 h-48 md:w-72 md:h-72 rounded-full border-[12px] border-white shadow-[0_32px_64px_-15px_rgba(0,0,0,0.1)] overflow-hidden transition-all duration-700 ease-out group-hover:scale-105 group-hover:-rotate-3 ring-1 ring-gray-100">
                        <img 
                            src="/imgs/githubprofile.png" 
                            alt="Aaron Israel" 
                            class="w-full h-full object-cover group-hover:grayscale-0 transition-all duration-700"
                        />
                    </div>
                </div>
            </div>

            <div class="max-w-3xl pt-8">
                <p class="text-xl text-gray-600 leading-relaxed border-l-4 border-blue-600 pl-8">
                    Me apasiona documentar y volcar cada bit de conocimiento del <span class="text-black font-semibold italic">mundo dev</span> en soluciones reales. Mi enfoque es construir arquitectura con propósito.
                </p>
                
                <div class="mt-10">
                    <a href="#proyectos" class="inline-block bg-black text-white px-10 py-5 rounded-sm font-bold hover:bg-blue-600 transition-all duration-300 transform hover:-translate-y-1 shadow-2xl shadow-black/10">
                        Ver Repositorios
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>